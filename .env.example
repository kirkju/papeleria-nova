# ─────────────────────────────────────────────────────────────────────────────
# Papelería Nova — environment variables (example)
# Copy this file to ".env" and fill in the real values. Do NOT commit your real .env.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL database (Prisma).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
# Example for a local instance:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/papeleria_nova?schema=public"

# ─────────────────────────────────────────────────────────────────────────────
# Authentication — NextAuth / Auth.js (JWT strategy)
# ─────────────────────────────────────────────────────────────────────────────

# Secret used to sign the session JWTs. REQUIRED.
# Generate a secure one with either of these commands:
#   npx auth secret
#   openssl rand -base64 32
AUTH_SECRET="reemplaza-esto-por-un-secreto-generado"

# Public URL of the app (needed in production and for OAuth callbacks).
# For local development it can stay like this:
AUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# Optional OAuth (Google). Only needed if you enable Google sign-in.
# Leave them empty if you don't use OAuth.
# ─────────────────────────────────────────────────────────────────────────────
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
